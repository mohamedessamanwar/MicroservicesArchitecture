{
  // Logging Configuration
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Connection Strings for different tenants/regions
  "ConnectionStrings": {
    "Egypt": {
      "Primary": "Host=pgbouncer;Port=6432;Database=PaymentDb;Username=admin;Password=pass;",
      "Replica": "Host=pgbouncer;Port=6432;Database=PaymentDbReplica;Username=admin;Password=pass;"
    },
    "USA": {
      "Primary": "Host=pgbouncer;Port=6432;Database=PaymentDb-USA;Username=admin;Password=pass;",
      "Replica": "Host=pgbouncer;Port=6432;Database=PaymentDb-USAReplica;Username=admin;Password=pass;"
    },
    "PaymentDatabase": "Host=pgbouncer;Port=6432;Database=PaymentDb;Username=admin;Password=pass;",
    "Redis": "redis:6379"
  },

  // RabbitMQ Configuration (used for health checks)
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": 5672
  },

  // Dependent Services URLs
  "Services": {
    "OrderService": "http://order-service:8080"
  },

  // Outbound HTTP Client Configuration
  "OutboundHttp": {
    "CallerIdentity": {
      "AppId": "payment-service",
      "SharedSecret": "payment-service-secret",
      "EnableSignature": true
    },
    "Defaults": {
      "MaxConnectionsPerServer": 64,
      "PooledConnectionLifetimeSeconds": 300,
      "PooledConnectionIdleTimeoutSeconds": 120,
      "ConnectTimeoutSeconds": 10,
      "OverallRequestTimeoutSeconds": 100,
      "MaxParallelRequests": 128,
      "MaxQueuedRequests": 256
    },
    "Clients": {
      "OrderService": {
        "Pipelines": {
          "Critical": {
            "TimeoutSeconds": 10,
            "RetryAttempts": 2,
            "EnableRetry": true,
            "EnableCircuitBreaker": true
          },
          "NoRetry": {
            "TimeoutSeconds": 10,
            "RetryAttempts": 0,
            "EnableRetry": false,
            "EnableCircuitBreaker": true
          },
          "Health": {
            "TimeoutSeconds": 2,
            "RetryAttempts": 1,
            "EnableRetry": true,
            "EnableCircuitBreaker": false
          }
        }
      }
    }
  },

  // Metrics and Monitoring Configuration
  "MetricMonitoring": {
    "Enabled": true,
    "SnapshotIntervalSeconds": 15,
    "SnapshotRetentionMinutes": 30,
    "MaxSnapshots": 500,
    "RequestRetentionMinutes": 15,
    "MaxStoredRequests": 2000,
    "SlowRequestThresholdMs": 1000,
    "SpikeCorrelationWindowSeconds": 60,
    "IncludeQueryString": false,
    "EnableSocketMetrics": true,
    "EnableDatabaseConnectionMetrics": true,
    "CpuSpikeThresholdPercent": 80,
    "WorkingSetSpikeThresholdMb": 1024,
    "ManagedHeapSpikeThresholdMb": 512,
    "Gen2CollectionDeltaThreshold": 3,
    "BusyWorkerThreadThreshold": 100
  },

  // Allowed Hosts for the application
  "AllowedHosts": "*"
}
