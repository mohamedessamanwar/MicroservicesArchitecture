{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OrderService.Infrastructure.RabbitImplementation": "Debug"
    }
  },

  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false",
    "Egypt": {
      "Primary": "Host=pgbouncer;Port=6432;Database=OrderDb;Username=admin;Password=pass;",
      "Replica": "Host=pgbouncer;Port=6432;Database=OrderDbReplica;Username=admin;Password=pass;"
    },
    "USA": {
      "Primary": "Host=pgbouncer;Port=6432;Database=OrderDb-USA;Username=admin;Password=pass;",
      "Replica": "Host=pgbouncer;Port=6432;Database=OrderDb-USAReplica;Username=admin;Password=pass;"
    }
  },

  "MetricMonitoring": {
    "Enabled": true,
    "SnapshotIntervalSeconds": 15,
    "SnapshotRetentionMinutes": 30,
    "MaxSnapshots": 500,
    "RequestRetentionMinutes": 15,
    "MaxStoredRequests": 2000,
    "SlowRequestThresholdMs": 1000,
    "SpikeCorrelationWindowSeconds": 60,
    "IncludeQueryString": false,
    "EnableSocketMetrics": true,
    "EnableDatabaseConnectionMetrics": true,
    "CpuSpikeThresholdPercent": 80,
    "WorkingSetSpikeThresholdMb": 1024,
    "ManagedHeapSpikeThresholdMb": 512,
    "Gen2CollectionDeltaThreshold": 3,
    "BusyWorkerThreadThreshold": 100
  },

  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "admin",
    "Password": "admin123",
    "Exchange": "cdc.exchange",
    "RoutingKey": "order-server.public.#",
    "QueueName": "order.write.cdc.q",
    "RetryCount": 5,
    "RetryDelaySeconds": 5,
    "DeadLetterExchange": "cdc.dlx",
    "DeadLetterQueue": "order.write.cdc.dlq",
    "DeadLetterRoutingKey": "order.write.cdc.dlq",
    "MessageTtlMs": 86400000,
    "MaxLength": 50000
  },

  
  "Messaging": {
    "Countries": [
      "Egypt",
      "USA"
    ],
    "Providers": [
      {
        "Name": "Broker",
        "Host": "rabbitmq",
        "Port": 5672,
        "VirtualHost": "/",
        "Username": "admin",
        "Password": "admin123",
        "HeartbeatSeconds": 30
      }
    ]
  },
  "Services": {
    "PaymentService": "http://payment-service:8080"
  },
  "OutboundHttp": {
    "CallerIdentity": {
      "AppId": "order-service",
      "SharedSecret": "order-service-secret",
      "EnableSignature": true
    },
    "Defaults": {
      "MaxConnectionsPerServer": 64,
      "PooledConnectionLifetimeSeconds": 300,
      "PooledConnectionIdleTimeoutSeconds": 120,
      "ConnectTimeoutSeconds": 10,
      "OverallRequestTimeoutSeconds": 100,
      "MaxParallelRequests": 128,
      "MaxQueuedRequests": 256
    },
    "Clients": {
      "PaymentService": {
        "Pipelines": {
          "Read": {
            "TimeoutSeconds": 8,
            "RetryAttempts": 2,
            "EnableRetry": true,
            "EnableCircuitBreaker": true
          },
          "NoRetry": {
            "TimeoutSeconds": 12,
            "RetryAttempts": 0,
            "EnableRetry": false,
            "EnableCircuitBreaker": true
          },
          "Critical": {
            "TimeoutSeconds": 15,
            "RetryAttempts": 2,
            "EnableRetry": true,
            "EnableCircuitBreaker": true
          }
        }
      }
    }
  },
  "InternalServiceAuth": {
    "RequireSignature": true,
    "AllowedClockSkewSeconds": 300,
    "AllowedApps": {
      "order-service": "order-service-secret",
      "payment-service": "payment-service-secret"
    }
  },
  "AllowedHosts": "*",
  "RequestLogging": {
    "EnableRequestBodyLogging": false,
    "MaxRequestBodyLogBytes": 4096,
    "SlowRequestThresholdMs": 1000,
    "SensitiveKeys": [ "password", "token", "access_token", "refresh_token", "secret", "key", "apiKey", "authorization", "otp", "code" ]
  },
  "ExceptionHandling": {
    "PersistExceptions": true,
    "IncludeExceptionDetailsInDevelopment": false
  }
}
