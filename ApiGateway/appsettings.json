{
  // Logging Configuration
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Kestrel Server Limits & Protection
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 5000,
      "RequestQueueLimit": 10000,
      "MaxRequestBodySize": 31457280,
      "KeepAliveTimeout": "00:01:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },

  // Allowed Hosts for the application
  "AllowedHosts": "*",

  // Reverse Proxy Configuration (YARP)
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/v1/Orders/{**catch-all}"
        }
      },
      "orders-route-root": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/v1/Orders"
        }
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/v1/Payments/{**catch-all}"
        }
      },
      "payments-route-root": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/v1/Payments"
        }
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/v1/Products/{**catch-all}"
        }
      },
      "products-route-root": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/v1/Products"
        }
      }
    },
    "Clusters": {
      "orders-cluster": {
        "HttpClient": {
          "MaxConnectionsPerServer": 100
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:05",
          "ConnectTimeout": "00:00:05"
        },
        "Destinations": {
          "orders-service": {
            "Address": "http://order-service:8080/"
          }
        }
      },
      "payments-cluster": {
        "HttpClient": {
          "MaxConnectionsPerServer": 100
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:05",
          "ConnectTimeout": "00:00:05"
        },
        "Destinations": {
          "payments-service": {
            "Address": "http://payment-service:8080/"
          }
        }
      },
      "products-cluster": {
        "HttpClient": {
          "MaxConnectionsPerServer": 100
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:05",
          "ConnectTimeout": "00:00:05"
        },
        "Destinations": {
          "product-service": {
            "Address": "http://product-service:8080/"
          }
        }
      }
    }
  }
}
